# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key — bypasses RLS

GATEWAY=fonnte # fonnte or meta
FONNTE_TOKEN=your-fonte-token

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# AI provider — "groq" (default) or "gemini"
AI_PROVIDER=groq
AI_API_KEY=
# Groq models: openai/gpt-oss-120b, openai/gpt-oss-20b (both support JSON mode)
# Gemini models: gemini-2.5-flash-lite, gemini-2.0-flash
AI_MODEL=

DASHBOARD_URL=https://your-dashboard.com


# Shared secret for the Fonnte webhook header (X-Fonnte-Token).
# Required when GATEWAY=fonnte — the webhook fails closed without it.
FONNTE_WEBHOOK_TOKEN=

# Optional. debug | info | warn | error.
# Defaults to info when NODE_ENV=production, debug otherwise.
LOG_LEVEL=info

# Optional. Set to "production" on the deployed Worker.
NODE_ENV=production
