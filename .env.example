# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key — bypasses RLS

GATEWAY=fonnte # fonnte or meta
FONNTE_TOKEN=your-fonte-token

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# AI provider — "groq" (default) or "gemini"
AI_PROVIDER=groq
AI_API_KEY=
# Groq models: llama-3.1-8b-instant, llama-3.3-70b-versatile, gemma2-9b-it
# Gemini models: gemini-2.5-flash-lite, gemini-2.0-flash
AI_MODEL=

DASHBOARD_URL=https://your-dashboard.com

